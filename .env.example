DATABASE_URL=postgresql://baixada:baixada@localhost:5435/baixada
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
# 32 bytes em base64url. Gere uma chave distinta para cada ambiente.
MFA_ENCRYPTION_KEY=replace-with-a-32-byte-base64url-key
# Create separate random HMAC keys for the web process and worker; register the same
# key_id/secret in app.rls_context_keys using the migration credential.
RLS_CONTEXT_KEY_ID=web-v1
RLS_CONTEXT_HMAC_KEY=replace-with-at-least-32-random-characters
RLS_SYSTEM_CONTEXT_KEY_ID=worker-v1
RLS_SYSTEM_CONTEXT_HMAC_KEY=replace-with-a-different-32+-character-key
MEDIA_ROOT=./uploads
MEDIA_DISK_STOP_PERCENT=80
EMAIL_PROVIDER=console
EMAIL_FROM=contato@example.com
# Use uma chave própria da aplicação Baixada; não reutilize chaves de outros projetos.
# Em produção, configure estes segredos no gerenciador de segredos do ambiente, nunca no repositório.
RESEND_API_KEY=
