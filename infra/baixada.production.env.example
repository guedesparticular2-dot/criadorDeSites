# Referência de variáveis para os arquivos root-only em infra/secrets/.
# Nunca use estes placeholders diretamente em produção nem faça commit dos segredos.

# infra/secrets/postgres.env (usado apenas pelo container Postgres)
POSTGRES_DB=baixada
POSTGRES_USER=baixada_owner
POSTGRES_PASSWORD=<senha-aleatoria-exclusiva>

# infra/secrets/migrator.env (uso operacional pontual, somente para migrações)
DATABASE_URL=postgresql://baixada_owner:<senha-aleatoria>@postgres:5432/baixada

# infra/secrets/web.env
APP_URL=https://baixadafc.com.br
DATABASE_URL=postgresql://baixada_runtime_login:<senha-aleatoria>@postgres:5432/baixada?sslmode=disable
MFA_ENCRYPTION_KEY=<32-bytes-aleatorios-em-base64url>
RLS_CONTEXT_KEY_ID=baixada-web-v1
RLS_CONTEXT_HMAC_KEY=<segredo-aleatorio-web-com-pelo-menos-32-caracteres>
MEDIA_ROOT=/data/uploads
MEDIA_DISK_STOP_PERCENT=80

# infra/secrets/worker.env
APP_URL=https://baixadafc.com.br
DATABASE_URL=postgresql://baixada_runtime_login:<senha-aleatoria>@postgres:5432/baixada?sslmode=disable
RLS_SYSTEM_CONTEXT_KEY_ID=baixada-worker-v1
RLS_SYSTEM_CONTEXT_HMAC_KEY=<segredo-aleatorio-worker-distinto-com-pelo-menos-32-caracteres>
EMAIL_PROVIDER=resend
EMAIL_FROM="Baixada Futsal Clube <nao-responda@baixadafc.com.br>"
EMAIL_REPLY_TO=baixadafc5@gmail.com
RESEND_API_KEY=<chave-de-envio-exclusiva-do-baixada>

# DNS esperado (sem AAAA até confirmar IPv6): apex A para o IP da VPS,
# www CNAME para o apex. O www redirecionará ao host canônico.
