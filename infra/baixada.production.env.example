# Exemplo sem credenciais. Copie para o cofre/configuração do Easypanel e
# substitua todos os placeholders por valores gerados para PRODUÇÃO.
APP_URL=https://baixadafc.com.br
APP_DOMAINS=baixadafc.com.br
TLS_EMAIL=<email-de-operacao>

# Use o hostname interno PostgreSQL exibido pelo Easypanel, nunca um IP presumido.
# A credencial de runtime deve ser baixada_runtime, nunca o owner/migrador.
DATABASE_URL=postgresql://baixada_runtime:<senha>@<hostname-interno-postgres>:5432/baixada?sslmode=disable

MFA_ENCRYPTION_KEY=<32-bytes-aleatorios-em-base64url>
RLS_CONTEXT_KEY_ID=baixada-web-v1
RLS_CONTEXT_HMAC_KEY=<segredo-aleatorio-web-com-pelo-menos-32-caracteres>
RLS_SYSTEM_CONTEXT_KEY_ID=baixada-worker-v1
RLS_SYSTEM_CONTEXT_HMAC_KEY=<segredo-aleatorio-worker-distinto-com-pelo-menos-32-caracteres>

# Recuperação de senha/convites exige configurar Resend antes do go-live.
EMAIL_PROVIDER=console
EMAIL_FROM=<remetente-verificado>
RESEND_API_KEY=<chave-exclusiva-do-baixada>
